# base64-encoded binary fixture for the 02-deep demo.
# The test suite reads the decoded `suspicious_sample.bin`; this file documents
# its exact bytes for reproducibility. Decode with:
#   python -c "import base64,sys;open('suspicious_sample.bin','wb').write(base64.b64decode(open('suspicious_sample.bin.base64').read().splitlines()[-1]))"
